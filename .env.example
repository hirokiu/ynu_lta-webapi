COMPOSE_PROJECT_NAME=kirokun-staging
RELEASE_ID=refactor-20260917
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
FIREBASE_CREDENTIALS_FILE=/absolute/path/outside/git/firebase.json
NOTIFICATIONS_ENABLED=false

# Invite-only username authentication; enable in Dev after verification.
USERNAME_ACCOUNTS_ENABLED=false
ACCOUNT_SCOPE=proto

# Capability switches (effective only when USERNAME_ACCOUNTS_ENABLED=true).
# Stop new registration without changing existing login or data.
ACCOUNT_INVITATIONS_ENABLED=true
ACCOUNT_PASSWORD_RESET_ENABLED=true
ACCOUNT_GOOGLE_REGISTRATION_ENABLED=true

# Protect host capacity; use 256m / 0.75 for Dev on the shared 2 GB host.
API_MEMORY_LIMIT=384m
API_CPU_LIMIT=1.0
