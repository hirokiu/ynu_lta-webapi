# Copy to the dev checkout .env; provision a separate Firebase project first.
COMPOSE_PROJECT_NAME=kirokun-dev
RELEASE_ID=SET_VERIFIED_RELEASE
HTTP_BIND=127.0.0.1
HTTP_PORT=8082
FIREBASE_CREDENTIALS_FILE=/opt/kirokun-secrets/dev/firebase.json
NOTIFICATIONS_ENABLED=false
ASSIGNMENT_PREPARATION_ENABLED=false

FIREBASE_PROJECT_ID=SET_FIREBASE_PROJECT_ID
# Public Web app configuration JSON, not a service account key.
FIREBASE_WEB_CONFIG=SET_PUBLIC_WEB_CONFIG_JSON
FIREBASE_DATABASE_URL=
