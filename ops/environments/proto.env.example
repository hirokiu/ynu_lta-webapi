# Copy to the proto checkout .env; keep the actual file outside Git.
COMPOSE_PROJECT_NAME=kirokun-proto
RELEASE_ID=SET_VERIFIED_RELEASE
HTTP_BIND=127.0.0.1
HTTP_PORT=8081
FIREBASE_CREDENTIALS_FILE=/opt/kirokun-secrets/proto/firebase.json
# Keep both disabled while validating a production copy.
NOTIFICATIONS_ENABLED=false
ASSIGNMENT_PREPARATION_ENABLED=false
